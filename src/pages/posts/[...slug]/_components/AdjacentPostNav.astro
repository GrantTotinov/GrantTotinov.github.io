---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const link = "card hover:border-accent/40 group flex flex-col gap-1 p-4 sm:p-5";
---

<nav
  aria-label="More posts"
  data-pagefind-ignore
  class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2"
>
  {
    prevPost && (
      <a href={getPostUrl(prevPost.id, prevPost.filePath, locale)} class={link}>
        <span class="text-muted-foreground flex items-center gap-1 text-sm">
          <IconArrowLeft class="size-4 rtl:rotate-180" aria-hidden="true" />
          {t.post.previousPost}
        </span>
        <span class="group-hover:text-accent leading-snug font-semibold">
          {prevPost.title}
        </span>
      </a>
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
        class:list={[link, "items-end text-end sm:col-start-2"]}
      >
        <span class="text-muted-foreground flex items-center gap-1 text-sm">
          {t.post.nextPost}
          <IconArrowRight class="size-4 rtl:rotate-180" aria-hidden="true" />
        </span>
        <span class="group-hover:text-accent leading-snug font-semibold">
          {nextPost.title}
        </span>
      </a>
    )
  }
</nav>
