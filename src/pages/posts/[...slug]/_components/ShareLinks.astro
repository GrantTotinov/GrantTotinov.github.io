---
import { tplStr, useTranslations } from "@/i18n";
import { getSocialIcon } from "@/utils/socialIcons";
import config from "@/config";

const { shareLinks } = config;
const t = useTranslations(Astro.currentLocale);

const pageUrl = Astro.url;

const platformLabel = (name: string) =>
  name === "linkedin"
    ? "LinkedIn"
    : name.charAt(0).toUpperCase() + name.slice(1);

const items = shareLinks.map(({ name, url, linkTitle }) => ({
  url,
  Icon: getSocialIcon(name),
  title:
    linkTitle ??
    (name === "mail"
      ? t.post.sharePostViaEmail
      : tplStr(t.post.sharePostOn, { platform: platformLabel(name) })),
}));
---

{
  items.some(({ Icon }) => Icon) && (
    <div class="flex items-center gap-2">
      <span class="text-muted-foreground text-sm">{t.post.sharePostIntro}</span>
      <ul class="flex">
        {items.map(({ url, title, Icon }) =>
          Icon ? (
            <li>
              <a
                href={`${url}${pageUrl}`}
                title={title}
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted-foreground hover:bg-accent-soft hover:text-accent grid size-9 place-items-center rounded-lg"
              >
                <Icon class="size-4" aria-hidden="true" />
                <span class="sr-only">{title}</span>
              </a>
            </li>
          ) : null
        )}
      </ul>
    </div>
  )
}
