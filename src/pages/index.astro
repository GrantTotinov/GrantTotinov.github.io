---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProfileCard from "@/components/ProfileCard.astro";
import Card from "@/components/Card.astro";
import Tag from "@/components/Tag.astro";
import { PROJECTS } from "@/data/projects";
import { getActiveContributions } from "@/data/contributions";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { slugifyStr } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const feed = [
  ...sortedPosts.filter(({ data }) => data.featured),
  ...sortedPosts.filter(({ data }) => !data.featured),
].slice(0, config.posts.perIndex);

const contributions = getActiveContributions(sortedPosts).map(project => ({
  ...project,
  count: sortedPosts.filter(({ data }) => data.repo === project.key).length,
}));
const tags = getUniqueTags(posts);

const sidebarLink =
  "hover:bg-accent-soft hover:text-accent flex gap-3 rounded-lg p-2";
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout flex-1 py-6 sm:py-8">
    <ProfileCard />

    <div class="mt-6 grid items-start gap-6 lg:grid-cols-[17rem_minmax(0,1fr)]">
      <section
        aria-labelledby="posts-heading"
        class="min-w-0 lg:col-start-2 lg:row-start-1"
      >
        <h2 id="posts-heading" class="font-title mb-4 text-xl">
          {t.home.recentPosts}
        </h2>
        <ul class="flex flex-col gap-4">
          {feed.map(post => <Card variant="h3" {...post} />)}
        </ul>
        {
          sortedPosts.length > feed.length && (
            <a
              href={getRelativeLocaleUrl(locale, "posts")}
              class="card hover:border-accent/40 hover:text-accent mt-4 block py-3 text-center font-semibold"
            >
              {t.home.allPosts}
            </a>
          )
        }
      </section>

      <aside class="flex flex-col gap-4 lg:col-start-1 lg:row-start-1">
        <section aria-labelledby="projects-heading" class="card p-3">
          <h2 id="projects-heading" class="font-title px-2 pt-1 text-base">
            <a
              href={getRelativeLocaleUrl(locale, "projects")}
              class="hover:text-accent"
            >
              Open source projects
            </a>
          </h2>
          <ul class="mt-1">
            {
              Object.values(PROJECTS).map(({ name, icon, description }) => (
                <li>
                  <a
                    href={getRelativeLocaleUrl(
                      locale,
                      `projects/#${slugifyStr(name)}`
                    )}
                    class={sidebarLink}
                  >
                    <Image
                      src={icon}
                      alt=""
                      width={80}
                      height={80}
                      class="size-10 shrink-0 rounded-lg"
                    />
                    <span class="min-w-0">
                      <span class="block font-semibold">{name}</span>
                      <span class="text-muted-foreground line-clamp-2 text-sm">
                        {description}
                      </span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="contributions-heading" class="card p-3">
          <h2 id="contributions-heading" class="font-title px-2 pt-1 text-base">
            <a
              href={getRelativeLocaleUrl(locale, "contributions")}
              class="hover:text-accent"
            >
              {t.nav.contributions}
            </a>
          </h2>
          <ul class="mt-1">
            {
              contributions.map(({ key, label, github, count }) => (
                <li>
                  <a
                    href={getRelativeLocaleUrl(locale, `contributions/${key}`)}
                    class:list={[sidebarLink, "items-center justify-between"]}
                  >
                    <span class="min-w-0">
                      <span class="block font-medium">{label}</span>
                      <span class="text-muted-foreground block truncate text-xs">
                        {github}
                      </span>
                    </span>
                    <span class="bg-muted text-muted-foreground rounded-full px-2 py-0.5 text-xs font-semibold">
                      {count}
                      <span class="sr-only">
                        {count === 1 ? "post" : "posts"}
                      </span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="tags-heading" class="card p-3">
          <h2 id="tags-heading" class="font-title px-2 pt-1 text-base">
            <a
              href={getRelativeLocaleUrl(locale, "tags")}
              class="hover:text-accent"
            >
              {t.nav.tags}
            </a>
          </h2>
          <ul class="mt-2 flex flex-wrap gap-0.5 px-0.5">
            {tags.map(({ tag, tagName }) => <Tag {tag} {tagName} size="sm" />)}
          </ul>
        </section>
      </aside>
    </div>
  </main>
  <Footer />
</Layout>
