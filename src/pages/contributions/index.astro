---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconGitMerge from "@/assets/icons/IconGitMerge.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getActiveContributions } from "@/data/contributions";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const posts = getSortedPosts(
  await getCollection("posts", ({ data }) => !data.draft)
);
const projects = getActiveContributions(posts).map(project => ({
  ...project,
  count: posts.filter(({ data }) => data.repo === project.key).length,
}));

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout title={`Contributions | ${config.site.title}`}>
  <Header />

  <Main
    pageTitle="Contributions"
    pageDesc="Open source projects I've had pull requests merged into, with a write-up for each one."
  >
    <ul class="flex flex-col gap-4">
      {
        projects.map(({ key, label, github, blurb, count }) => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `contributions/${key}`)}
              class="card hover:border-accent/40 group block p-5 sm:p-6"
            >
              <span class="flex items-baseline justify-between gap-4">
                <span class="font-title group-hover:text-accent text-xl">
                  {label}
                </span>
                <span class="text-muted-foreground shrink-0 text-sm">
                  {count} {count === 1 ? "post" : "posts"}
                </span>
              </span>
              <span class="text-accent mt-1 flex items-center gap-1.5 text-sm font-medium">
                <IconGitMerge class="size-4" aria-hidden="true" />
                {github}
              </span>
              <span class="text-foreground/80 mt-3 block">{blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
