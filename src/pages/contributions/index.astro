---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import { getActiveContributions } from "@/data/contributions";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const posts = getSortedPosts(
  await getCollection("posts", ({ data }) => !data.draft)
);
const projects = getActiveContributions(posts).map(project => ({
  ...project,
  count: posts.filter(({ data }) => data.repo === project.key).length,
}));

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout title={`Contributions | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle="Contributions"
    pageDesc="Open source projects I've had pull requests merged into, with a write-up for each one."
  >
    <ul>
      {
        projects.map(({ key, label, github, blurb, count }) => (
          <li class="my-6">
            <a
              href={getRelativeLocaleUrl(locale, `contributions/${key}`)}
              class="text-accent text-lg font-medium decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline"
            >
              {label}
            </a>
            <span class="text-muted-foreground ms-2 text-sm">
              {github} · {count} {count === 1 ? "post" : "posts"}
            </span>
            <p>{blurb}</p>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
