---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getActiveContributions } from "@/data/contributions";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getSocialIcon } from "@/utils/socialIcons";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = getSortedPosts(
    await getCollection("posts", ({ data }) => !data.draft)
  );

  return getActiveContributions(posts).flatMap(project =>
    paginate(
      posts.filter(({ data }) => data.repo === project.key),
      {
        params: { repo: project.key },
        props: { project },
        pageSize: config.posts.perPage,
      }
    )
  );
}

const { page, project } = Astro.props;

const GitHubIcon = getSocialIcon("github");
---

<Layout title={`${project.label} contributions | ${config.site.title}`}>
  <Header />

  <Main
    pageTitle={project.label}
    pageDesc={`${project.blurb} Write-ups of my merged pull requests to ${project.github}.`}
  >
    <a
      href={`https://github.com/${project.github}/pulls?q=is%3Apr+author%3AGrantTotinov`}
      class="border-border hover:border-accent/30 hover:bg-accent-soft hover:text-accent -mt-2 mb-6 inline-flex items-center gap-2 rounded-lg border px-3 py-1.5 text-sm font-medium"
    >
      {GitHubIcon && <GitHubIcon class="size-4" aria-hidden="true" />}
      All my pull requests to {project.github}
    </a>
    <ul class="flex flex-col gap-4">
      {page.data.map(data => <Card {...data} />)}
    </ul>
    <Pagination {page} />
  </Main>

  <Footer />
</Layout>
