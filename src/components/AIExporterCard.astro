---
import { Image } from "astro:assets";
import icon from "@/assets/images/aiexporter-icon.png";

type Props = { headingLevel?: "h2" | "h3" };
const { headingLevel: Heading = "h3" } = Astro.props;

const links = [
  {
    label: "Chrome Web Store",
    href: "https://chromewebstore.google.com/detail/objkcakdcilfaphifjfcgfamlnnbinjc",
  },
  { label: "Website", href: "https://granttotinov.github.io/AIExporter/" },
  {
    label: "Source on GitHub",
    href: "https://github.com/GrantTotinov/AIExporter",
  },
];
---

<div class="border-border flex gap-4 rounded-lg border p-4 sm:gap-5 sm:p-5">
  <Image
    src={icon}
    alt=""
    width={64}
    height={64}
    class="size-12 shrink-0 sm:size-16"
  />
  <div>
    <Heading class="text-accent text-lg font-semibold">AI Exporter</Heading>
    <p class="mt-1">
      A free browser extension that saves your ChatGPT, Claude, Gemini and
      twelve other AI chats as PDF, Word, Markdown, Excel and five more formats,
      images included. Everything happens locally in your browser.
    </p>
    <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {
        links.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class="hover:text-accent underline decoration-dashed underline-offset-4"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
