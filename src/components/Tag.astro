---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    class:list={[
      "text-muted-foreground hover:border-accent/30 hover:bg-accent-soft hover:text-accent inline-flex items-center rounded-md border border-transparent",
      size === "sm" ? "px-1.5 py-0.5 text-sm" : "px-2.5 py-1",
    ]}
  >
    <span aria-hidden="true" class="text-accent/70">#</span>{tagName}
  </a>
</li>
