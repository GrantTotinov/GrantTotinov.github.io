---
import config from "@/config";
import { getSocialIcon } from "@/utils/socialIcons";

type Props = {
  links?: (typeof config.socials)[number][];
  /** "icons": icon buttons. "labels": icon and name, for the profile card. */
  variant?: "icons" | "labels";
  class?: string;
};

const {
  links = config.socials,
  variant = "icons",
  class: className,
} = Astro.props;

const { author } = config.site;

const items = links.map(({ name, label, url, linkTitle }) => ({
  url,
  label,
  Icon: getSocialIcon(name),
  title:
    linkTitle ??
    (url.startsWith("mailto:")
      ? `Send an email to ${author}`
      : `${author} on ${label}`),
}));
---

<ul
  class:list={[
    "flex flex-wrap",
    variant === "labels" ? "gap-x-1 gap-y-1" : "gap-0.5",
    className,
  ]}
>
  {
    items.map(({ url, label, title, Icon }) => (
      <li>
        <a
          href={url}
          title={title}
          rel="me"
          class:list={[
            "text-muted-foreground hover:bg-accent-soft hover:text-accent inline-flex items-center rounded-lg",
            variant === "labels"
              ? "gap-1.5 px-2 py-1 text-sm font-medium"
              : "size-9 justify-center",
          ]}
        >
          {Icon && <Icon class="size-4 shrink-0" aria-hidden="true" />}
          {variant === "labels" ? label : <span class="sr-only">{title}</span>}
        </a>
      </li>
    ))
  }
</ul>
