---
import Socials from "./Socials.astro";
import config from "@/config";

const currentYear = new Date().getFullYear();
---

<footer class="bg-surface border-border mt-auto border-t">
  <div
    class="app-layout flex flex-col gap-4 py-8 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <p class="font-title">{config.site.author}</p>
      <p class="text-muted-foreground mt-1 text-sm">
        {config.site.description}
      </p>
      <p class="text-muted-foreground mt-3 text-sm">
        &#169; {`${currentYear} ${config.site.author}`}
      </p>
    </div>
    <Socials class="-ms-2 sm:ms-0" />
  </div>
</footer>
