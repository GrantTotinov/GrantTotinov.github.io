---
type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
};

const { pageTitle, pageDesc } = Astro.props;
---

<main id="main-content" class="app-layout flex-1 py-8 sm:py-10">
  <div class="max-w-app mx-auto">
    <h1 class="font-title text-3xl leading-tight sm:text-4xl">{pageTitle}</h1>
    {pageDesc && <p class="text-muted-foreground mt-2 text-lg">{pageDesc}</p>}
    <div class="mt-8">
      <slot />
    </div>
  </div>
</main>
