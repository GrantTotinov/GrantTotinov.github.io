---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import avatar from "@/assets/images/avatar.jpg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { getActiveContributions } from "@/data/contributions";
import { getSortedPosts } from "@/utils/getSortedPosts";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const contributions = getActiveContributions(
  getSortedPosts(await getCollection("posts"))
);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const navLink =
  "text-muted-foreground hover:bg-accent-soft hover:text-accent block rounded-lg px-3 py-2 font-medium";
const iconButton =
  "text-muted-foreground hover:bg-accent-soft hover:text-accent relative grid size-10 place-items-center rounded-lg";
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-surface text-accent absolute inset-s-16 -top-full z-50 rounded-lg px-3 py-2 transition-all focus:top-3"
>
  {t.a11y.skipToContent}
</a>

<header class="bg-surface border-border sticky top-0 z-40 border-b">
  <div class="app-layout relative flex h-14 items-center gap-1">
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="me-auto flex items-center gap-2.5 rounded-lg"
    >
      <Image
        src={avatar}
        alt=""
        width={64}
        height={64}
        class="size-8 rounded-full"
      />
      <span class="font-title text-lg whitespace-nowrap">{site.title}</span>
    </a>
    <nav id="nav-menu" aria-label="Main" class="order-last sm:order-none">
      <button
        id="menu-btn"
        class:list={[iconButton, "sm:hidden"]}
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
      <ul
        id="menu-items"
        class="bg-surface border-border absolute inset-x-0 top-full hidden gap-1 border-b p-3 shadow-sm sm:static sm:flex sm:items-center sm:border-0 sm:p-0 sm:shadow-none"
      >
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={[navLink, { "active-nav": isActive("/posts") }]}
          >
            {t.nav.posts}
          </a>
        </li>
        {
          contributions.length > 0 && (
            <li class="relative">
              <details class="contributions-menu group">
                <summary
                  class:list={[
                    navLink,
                    "flex cursor-pointer list-none items-center gap-1 [&::-webkit-details-marker]:hidden",
                    { "active-nav": isActive("/contributions") },
                  ]}
                >
                  {t.nav.contributions}
                  <span
                    aria-hidden="true"
                    class="text-xs transition-transform group-open:rotate-180"
                  >
                    ▾
                  </span>
                </summary>
                <ul class="border-border bg-surface z-50 mt-1 min-w-56 rounded-xl border p-1.5 sm:absolute sm:end-0 sm:top-full sm:mt-2 sm:shadow-lg">
                  {contributions.map(({ key, label, github }) => (
                    <li>
                      <a
                        href={getRelativeLocaleUrl(
                          locale,
                          `contributions/${key}`
                        )}
                        class:list={[
                          "hover:bg-accent-soft hover:text-accent block rounded-lg px-3 py-2",
                          {
                            "text-accent":
                              currentPath === `/contributions/${key}`,
                          },
                        ]}
                      >
                        <span class="block font-medium">{label}</span>
                        <span class="text-muted-foreground block text-xs">
                          {github}
                        </span>
                      </a>
                    </li>
                  ))}
                  <li class="border-border mt-1 border-t pt-1">
                    <a
                      href={getRelativeLocaleUrl(locale, "contributions")}
                      class="hover:bg-accent-soft hover:text-accent block rounded-lg px-3 py-2 text-sm font-medium"
                    >
                      All contributions
                    </a>
                  </li>
                </ul>
              </details>
            </li>
          )
        }
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "projects")}
            class:list={[navLink, { "active-nav": isActive("/projects") }]}
          >
            {t.nav.projects}
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "tags")}
            class:list={[navLink, { "active-nav": isActive("/tags") }]}
          >
            {t.nav.tags}
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={[navLink, { "active-nav": isActive("/about") }]}
          >
            {t.nav.about}
          </a>
        </li>
        {
          features.showArchives && (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, "archives")}
                class:list={[
                  navLink,
                  "flex items-center gap-2",
                  { "active-nav": isActive("/archives") },
                ]}
              >
                <IconArchive class="size-5" aria-hidden="true" />
                {t.nav.archives}
              </a>
            </li>
          )
        }
      </ul>
    </nav>
    {
      features.search !== false && (
        <a
          href={getRelativeLocaleUrl(locale, "search")}
          class:list={[iconButton, { "active-nav": isActive("/search") }]}
          title={t.nav.search}
        >
          <IconSearch class="size-5" aria-hidden="true" />
          <span class="sr-only">{t.nav.search}</span>
        </a>
      )
    }
    {
      features.lightAndDarkMode && (
        <button
          id="theme-btn"
          class={iconButton}
          title={t.a11y.toggleTheme}
          aria-label="auto"
          aria-live="polite"
        >
          <IconMoon class="absolute top-1/2 left-1/2 size-5 -translate-1/2 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
          <IconSunHigh class="absolute top-1/2 left-1/2 size-5 -translate-1/2 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
        </button>
      )
    }
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? openLabel : closeLabel);

      menuItems.classList.toggle("hidden");
      menuItems.classList.toggle("grid");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  // Close the Contributions dropdown on outside click, Escape or navigation.
  function closeContributionsMenu(except?: Element | null) {
    document
      .querySelectorAll<HTMLDetailsElement>("details.contributions-menu[open]")
      .forEach(menu => {
        if (menu !== except) menu.open = false;
      });
  }
  document.addEventListener("click", e => {
    closeContributionsMenu(
      (e.target as Element).closest("details.contributions-menu")
    );
  });
  document.addEventListener("keydown", e => {
    if (e.key === "Escape") closeContributionsMenu();
  });
  document.addEventListener("astro:after-swap", () => closeContributionsMenu());

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>
