---
import { Image } from "astro:assets";
import type { Project } from "@/data/projects";

type Props = { project: Project; headingLevel?: "h2" | "h3" };
const {
  project: { name, icon, description, links },
  headingLevel: Heading = "h3",
} = Astro.props;
---

<div class="flex gap-4 sm:gap-5">
  <Image
    src={icon}
    alt=""
    width={128}
    height={128}
    class="size-12 shrink-0 rounded-xl sm:size-16"
  />
  <div class="min-w-0">
    <Heading class="font-title text-xl sm:text-2xl">{name}</Heading>
    <p class="text-foreground/80 mt-1 leading-relaxed">{description}</p>
    <ul class="mt-4 flex flex-wrap gap-2 text-sm">
      {
        links.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class="border-border hover:border-accent/30 hover:bg-accent-soft hover:text-accent inline-flex rounded-lg border px-3 py-1.5 font-medium"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
