---
import { Image } from "astro:assets";
import type { Project } from "@/data/projects";

type Props = { project: Project; headingLevel?: "h2" | "h3" };
const {
  project: { name, icon, description, links },
  headingLevel: Heading = "h3",
} = Astro.props;
---

<div class="border-border flex gap-4 rounded-lg border p-4 sm:gap-5 sm:p-5">
  <Image
    src={icon}
    alt=""
    width={64}
    height={64}
    class="size-12 shrink-0 sm:size-16"
  />
  <div>
    <Heading class="text-accent text-lg font-semibold">{name}</Heading>
    <p class="mt-1">{description}</p>
    <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {
        links.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class="hover:text-accent underline decoration-dashed underline-offset-4"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
