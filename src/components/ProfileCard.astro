---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import avatar from "@/assets/images/avatar.jpg";
import Socials from "./Socials.astro";
import { getSocialIcon } from "@/utils/socialIcons";
import config from "@/config";

type Props = {
  /** "hero": top of the home page. "aside": next to a post. */
  variant?: "hero" | "aside";
};

const { variant = "hero" } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const credentials = [
  "M.Eng. in Computer Engineering",
  ".NET Foundation member",
  "Microsoft Q&A Champion",
];

// The first support link is the main call to action.
const support = config.support.map(({ name, label, url }, index) => ({
  label,
  url,
  primary: index === 0,
  Icon: getSocialIcon(name),
}));
---

{
  variant === "hero" ? (
    <section aria-labelledby="profile-name" class="card p-5 sm:p-8">
      <div class="flex flex-col gap-5 sm:flex-row sm:gap-7">
        <Image
          src={avatar}
          alt="Grant Totinov"
          width={224}
          height={224}
          loading="eager"
          class="size-16 shrink-0 rounded-full sm:size-28"
        />
        {/* Support links come last on phones and sit top right from md up. */}
        <div class="grid min-w-0 flex-1 content-start gap-y-4 md:grid-cols-[1fr_auto] md:gap-x-6">
          <h1
            id="profile-name"
            class="font-title text-3xl leading-tight sm:text-4xl"
          >
            {config.site.author}
          </h1>
          <ul class="-mt-1 flex flex-wrap gap-2 md:col-span-2">
            {credentials.map(item => (
              <li class="bg-muted rounded-full px-3 py-1 text-sm">{item}</li>
            ))}
          </ul>
          <p class="text-foreground/90 max-w-2xl leading-relaxed md:col-span-2">
            Software engineer from Bulgaria. I contribute to open source
            projects such as ASP.NET Core, Spectre.Console and Tiptap, and I
            build AI Exporter and PixelForge. This blog is where I write up what
            I learn along the way, with links to the pull requests and specs
            behind each post.
          </p>
          <Socials variant="labels" class="-ms-2 md:col-span-2" />
          <div class="flex flex-wrap gap-2 md:col-start-2 md:row-start-1">
            {support.map(({ label, url, primary, Icon }) => (
              <a
                href={url}
                class:list={[
                  "inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold",
                  primary
                    ? "bg-accent text-accent-foreground hover:bg-accent/85"
                    : "border-border hover:border-accent/30 hover:bg-accent-soft hover:text-accent border",
                ]}
              >
                {Icon && <Icon class="size-4" aria-hidden="true" />}
                {label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section aria-labelledby="author-name" class="card p-5">
      <div class="flex items-center gap-3">
        <Image
          src={avatar}
          alt=""
          width={96}
          height={96}
          class="size-12 shrink-0 rounded-full"
        />
        <h2 id="author-name" class="font-title text-lg leading-tight">
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class="hover:text-accent"
          >
            {config.site.author}
          </a>
        </h2>
      </div>
      <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
        Software engineer from Bulgaria, writing up the open source fixes I work
        on.
      </p>
      <ul class="mt-3 flex flex-col gap-1.5 text-sm">
        {credentials.map(item => (
          <li class="flex items-center gap-2">
            <span
              aria-hidden="true"
              class="bg-accent size-1.5 shrink-0 rounded-full"
            />
            {item}
          </li>
        ))}
      </ul>
      <Socials class="-ms-2 mt-3" />
      <div class="mt-4 flex flex-col gap-2">
        {support.map(({ label, url, primary, Icon }) => (
          <a
            href={url}
            class:list={[
              "inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold",
              primary
                ? "bg-accent text-accent-foreground hover:bg-accent/85"
                : "border-border hover:border-accent/30 hover:bg-accent-soft hover:text-accent border",
            ]}
          >
            {Icon && <Icon class="size-4" aria-hidden="true" />}
            {label}
          </a>
        ))}
      </div>
    </section>
  )
}
